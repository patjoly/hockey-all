# 2025 09 12 -- looking into event_angle for shots behind the net
VimR.selection()
# . set with Python data
df = data.frame( pbp_part )
my_cols = c( 'game_id', 'game_seconds', 'home_team', 'period', 'event_team', 'event_zone', 'event_type', 'details.reason', 'coords_x', 'coords_y', 'event_distance', 'event_angle', 'home_zone', 'is_long_shot' )
mask <- abs(df$coords_x) > 89 & df$event_type %in% st.fenwick_events & !df$is_long_shot
mask <- ifelse( is.na( mask), FALSE, mask )
View( df[ mask, my_cols ] )
# . set with R-scraped data
VimR.selection()
my_cols = c( 'game_id', 'game_seconds', 'home_team', 'game_period', 'event_team', 'event_zone', 'event_type', 'event_description', 'coords_x', 'coords_y', 'event_distance', 'event_angle', 'home_zone' )
# I don't have a boolean for long shots so this subset will include long shots from behind the other net
mask <- abs(pbp_part$coords_x) > 89 & pbp_part$event_type %in% st.fenwick_events
mask <- ifelse( is.na( mask), FALSE, mask )
tmp <- pbp_part[ mask, my_cols ]
View( tmp[ order( tmp$game_id, tmp$game_seconds ), ]  )
